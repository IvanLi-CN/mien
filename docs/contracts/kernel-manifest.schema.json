{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mien.local/contracts/kernel-manifest.schema.json",
  "title": "Mien kernel capability manifest",
  "description": "Machine-readable companion to docs/specs/browser-runtime/SPEC.md and docs/specs/fingerprint-engine/SPEC.md. The SPECs remain normative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kernel_version",
    "platform",
    "sha256",
    "flags",
    "seed_derived",
    "known_issues",
    "sandbox",
    "headless_ua_patch"
  ],
  "properties": {
    "kernel_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "platform": {
      "enum": ["macos-arm64", "linux-x86_64", "windows-x64"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/flagSpec"
      }
    },
    "seed_derived": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "known_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "headless_ua_patch": {
      "type": "boolean"
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_namespace_sandbox"],
      "properties": {
        "requires_namespace_sandbox": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "flagSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["uint32", "integer", "string", "boolean"]
        },
        "values": {
          "type": "array",
          "items": {"type": "string"}
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
