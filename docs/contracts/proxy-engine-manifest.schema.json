{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mien.local/contracts/proxy-engine-manifest.schema.json",
  "title": "Mien proxy engine capability manifest",
  "description": "Machine-readable companion to docs/specs/proxy-gateway/SPEC.md. The SPEC remains normative. v1 records the shared Xray-core engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine",
    "version",
    "platform",
    "sha256",
    "license",
    "protocols",
    "connection_reuse"
  ],
  "properties": {
    "engine": {
      "enum": ["xray-core"]
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "platform": {
      "enum": ["macos-arm64", "linux-x86_64", "windows-x64"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the published release asset (the downloaded archive), never the extracted engine binary digest. Install records carry asset_sha256 and binary_sha256 separately; engine verification uses binary_sha256."
    },
    "license": {
      "enum": ["MPL-2.0"]
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "connection_reuse": {
      "type": "boolean"
    },
    "protocols": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "http": {"$ref": "#/$defs/basicProtocolSpec"},
        "https": {"$ref": "#/$defs/basicProtocolSpec"},
        "socks5": {"$ref": "#/$defs/basicProtocolSpec"},
        "vless": {"$ref": "#/$defs/tierAProtocolSpec"},
        "vmess": {"$ref": "#/$defs/tierAProtocolSpec"},
        "shadowsocks": {"$ref": "#/$defs/tierAProtocolSpec"},
        "trojan": {"$ref": "#/$defs/tierAProtocolSpec"},
        "hysteria2": {"$ref": "#/$defs/tierBProtocolSpec"},
        "wireguard": {"$ref": "#/$defs/tierBProtocolSpec"}
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "protocolSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "transports", "tls_modes"],
      "properties": {
        "tier": {
          "enum": ["A", "B", "basic"],
          "description": "A = VLESS/VMess/Shadowsocks/Trojan release gate; B = Hysteria2/WireGuard declared support with explicit failure reporting; basic = HTTP/HTTPS/SOCKS5 base forward-proxy capability outside the A/B gates."
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["tcp", "udp", "ws", "grpc", "http", "httpupgrade", "quic"]
          }
        },
        "tls_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["none", "tls", "reality"]
          }
        },
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "plugins": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "obfuscation": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"},
          "description": "Obfuscation methods declared by this engine. Empty means the engine does not support obfuscated configurations; configs carrying obfuscation must be rejected. Omitting the key is equivalent to an empty array, but shipped manifests must state it explicitly so capability changes are reviewable."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "tierAProtocolSpec": {
      "allOf": [
        {"$ref": "#/$defs/protocolSpec"},
        {"properties": {"tier": {"const": "A"}}}
      ]
    },
    "tierBProtocolSpec": {
      "allOf": [
        {"$ref": "#/$defs/protocolSpec"},
        {"properties": {"tier": {"const": "B"}}}
      ]
    },
    "basicProtocolSpec": {
      "allOf": [
        {"$ref": "#/$defs/protocolSpec"},
        {"properties": {"tier": {"const": "basic"}}}
      ]
    }
  }
}
