{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口最小授权：核心 IPC 与应用命令；dialog/opener 在对应功能落地时追加",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-profiles-list",
    "allow-profiles-get",
    "allow-profiles-create",
    "allow-profiles-update",
    "allow-kernel-install",
    "allow-runtime-start",
    "allow-runtime-stop",
    "allow-runtime-status"
  ]
}
