        "server": "cdn.example.test",
        "port": 443,
        "options": {
          "security": "tls",
          "transport": "ws",
          "host": "cdn.example.test",
          "path": "/tj",
          "sni": "cdn.example.test"
        },
        "credential_fields": [
          "password"
        ],
        "warnings": []
      }
    },
    {
      "name": "trojan-sni-fallback-warning",
      "link": "trojan://password-test@edge.example.test:443",
      "expect": {
        "kind": "trojan",
        "server": "edge.example.test",
        "port": 443,
        "options": {
          "security": "tls",
          "transport": "tcp",
          "sni": "edge.example.test"
        },
        "credential_fields": [
          "password"
        ],
        "warnings": [
